# Copy to deploy/.env on the server. Read by Docker Compose and deploy/update.sh; the app never sees these.

# Which Compose files run: the app, the published image (automatic updates) and one way in.
#   Caddy:              docker-compose.yml:docker-compose.image.yml:docker-compose.caddy.yml
#   Cloudflare Tunnel:  docker-compose.yml:docker-compose.image.yml:docker-compose.tunnel.yml
# Without docker-compose.image.yml the app is built from this checkout (`docker compose up -d --build`).
COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml:docker-compose.caddy.yml

# The Mac's Tailscale IP (`tailscale ip -4` on the Mac).
MAC_TAILSCALE_IP=100.x.y.z

# Caddy only: the site's host name, e.g. 129-225-97-229.sslip.io.
SITE_ADDRESS=

# Tunnel only: token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command).
CLOUDFLARE_TUNNEL_TOKEN=

# Folder on the server for the database, master key and backups.
CA_MODE_HOME=/srv/ca-mode

# The image deploy/update.sh deploys. Pin one version with its :sha-<commit> tag; empty means :main.
CA_MODE_IMAGE=

# Optional: where ca-mode-update-failed.service POSTs a one-line alert when an update fails
# (an ntfy.sh topic, or any webhook that accepts a plain-text POST). Empty: the journal only.
CA_MODE_ALERT_URL=
