# Copy to deploy/.env on the server. Read by Docker Compose only; the app never sees these.

# The Mac's Tailscale IP (`tailscale ip -4` on the Mac).
MAC_TAILSCALE_IP=100.x.y.z

# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel > Docker command).
CLOUDFLARE_TUNNEL_TOKEN=

# Folder on the server for the database, master key and backups.
CA_MODE_HOME=/srv/ca-mode
