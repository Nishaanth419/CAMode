# Copy to deploy/app.env on the server: the app's settings (see the root .env.example for all of them).

# The public address. INDmoney sign-in redirects to <APP_ORIGIN>/auth/indmoney/callback.
APP_ORIGIN=https://camode.example.com

# Sign-in. A public HTTPS APP_ORIGIN refuses to start in local mode (the picker lists every profile) unless
# BEHIND_ACCESS=true says Cloudflare Access lets only your team in (docs/hosting.md).
AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# BEHIND_ACCESS=true

# Usage limits. TRUSTED_PROXY is the proxy in front of the app: caddy (docker-compose.caddy.yml) or
# cloudflare (the tunnel). Without it every visitor shares the proxy's address and one limit.
RATE_LIMITS_ENABLED=true
TRUSTED_PROXY=caddy
# Cloudflare Turnstile on sign-up (both keys, or neither).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

OLLAMA_MODEL=ca-mode
AI_PROVIDER=ollama
# One Ollama on the Mac answers everyone. MODEL_CONCURRENCY is how many calls it runs at once (set it to the Mac's
# OLLAMA_NUM_PARALLEL); others wait up to MODEL_QUEUE_SECONDS, then the chat says the assistant is busy (503).
# CHAT_DEADLINE_SECONDS bounds a whole answer: keep it below the proxy's timeout (Caddy has none by default;
# Cloudflare's is 100 s, so use 90 behind the tunnel).
MODEL_CONCURRENCY=1
MODEL_QUEUE_SECONDS=20
CHAT_DEADLINE_SECONDS=240
# Leave these empty so portfolio data can only go to the Mac's Ollama.
OPENAI_API_KEY=
GROQ_API_KEY=

MCP_SERVER_URL=https://mcp.indmoney.com/mcp
SNAPSHOT_TIME=09:00
SNAPSHOT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Free plan: 10 answered questions a day per profile. The cap never goes above FREE_DAILY_QUESTIONS in
# app/limits.py, so a change there deploys with the image; a smaller number here lowers it (README: "Plans and pricing").
# Give paying profiles a plan with: docker compose exec app python -m scripts.plans set <profile> individual
DAILY_QUESTION_LIMIT=10
# Where the /pricing page's buttons send an email.
PRICING_CONTACT_EMAIL=

# Backups: daily copies are automatic (BACKUP_KEEP, 14) and manual ones (deploys, admin page) are kept apart
# (BACKUP_MANUAL_KEEP, 5). Profiles never start backups on a hosted copy; BACKUPS_IN_APP=true would allow it.
# BACKUP_KEEP=14
# BACKUP_MANUAL_KEEP=5

# Seconds requests in flight get to finish when the app restarts (Compose's stop_grace_period is 100 s).
# GRACEFUL_SHUTDOWN_SECONDS=90

# Admin page at <APP_ORIGIN>/admin (README: "Admin page"): Google accounts allowed in, comma-separated.
# Needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
ADMIN_EMAILS=
