# Copy to deploy/app.env on the server: the app's settings (see the root .env.example for all of them).

# The public address. INDmoney sign-in redirects to <APP_ORIGIN>/auth/indmoney/callback.
APP_ORIGIN=https://camode.example.com

OLLAMA_MODEL=ca-mode
AI_PROVIDER=ollama
# Leave these empty so portfolio data can only go to the Mac's Ollama.
OPENAI_API_KEY=
GROQ_API_KEY=

MCP_SERVER_URL=https://mcp.indmoney.com/mcp
SNAPSHOT_TIME=09:00
SNAPSHOT_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Free plan: 10 answered questions a day per profile. The cap never goes above FREE_DAILY_QUESTIONS in
# app/limits.py, so a change there deploys with the image; a smaller number here lowers it (README: "Plans and pricing").
# Give paying profiles a plan with: docker compose exec app python -m scripts.plans set <profile> individual
DAILY_QUESTION_LIMIT=10
# Where the /pricing page's buttons send an email.
PRICING_CONTACT_EMAIL=

# Admin page at <APP_ORIGIN>/admin (README: "Admin page"): Google accounts allowed in, comma-separated.
# Needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET.
ADMIN_EMAILS=
