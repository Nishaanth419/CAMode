[Unit]
Description=Update CA Mode to the newest published image
After=docker.service network-online.target
Wants=network-online.target
# A failed update (pull, backup, start, or a rollback) runs the alert unit.
OnFailure=ca-mode-update-failed.service

[Service]
Type=oneshot
# update.sh works in CA_MODE_DEPLOY_DIR (default /srv/ca-mode/app, the folder with the Compose files and .env)
# and reads CA_MODE_IMAGE from that .env itself.
ExecStart=/usr/local/bin/ca-mode-update
