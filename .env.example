# Copy this file to .env for local development.
# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional additional AI providers. Add the key for each provider you want to
# select in the app. Kimi also accepts MOONSHOT_API_KEY as an alias.
KIMI_API_KEY=
KIMI_MODEL=kimi-k3
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq request budget defaults leave room under common on-demand TPM limits.
GROQ_INPUT_TOKEN_BUDGET=5600
GROQ_COMPLETION_TOKEN_LIMIT=1200

# Optional local Ollama model. In Docker Desktop, Ollama runs on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Optional provider default (openai, kimi, groq, or ollama).
AI_PROVIDER=openai

# INDmoney MCP endpoint
MCP_SERVER_URL=https://mcp.indmoney.com/mcp

# Local app origin (OAuth callback uses this exact address).
APP_ORIGIN=http://localhost:8003

# Port inside the local Docker container.
PORT=8080
