# Copy this file to .env for local development.
# Do not commit real API keys.

# Local model (recommended for privacy): answers are generated on this computer
# by Ollama, so messages and portfolio data are never sent to an AI company.
# Build the model once (see README), then keep this line. Leave the cloud keys
# below empty to make sending data to OpenAI or Groq impossible.
OLLAMA_MODEL=ca-mode
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_ROUTER_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional additional AI provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq request budget defaults leave room under common on-demand TPM limits.
GROQ_INPUT_TOKEN_BUDGET=5600
GROQ_COMPLETION_TOKEN_LIMIT=1200

# Optional model endpoints (OpenAI-compatible).
# OPENAI_BASE_URL=https://api.openai.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Provider selected when the app opens (ollama, openai or groq).
AI_PROVIDER=ollama

# Each message is first classified by the AI provider (finance or not, needs
# account data or not). Set a smaller model of the same provider to make this
# step cheaper and faster; it defaults to the chat model above. Set
# REQUEST_ROUTER=keywords to use the offline keyword rules instead.
# OPENAI_ROUTER_MODEL=
# GROQ_ROUTER_MODEL=
# REQUEST_ROUTER=model

# INDmoney MCP endpoint
MCP_SERVER_URL=https://mcp.indmoney.com/mcp

# Daily portfolio snapshot schedule (local time in SNAPSHOT_TIMEZONE).
SNAPSHOT_TIME=09:00
SNAPSHOT_TIMEZONE=Asia/Kolkata
SNAPSHOT_RETENTION_DAYS=365
# Set to false to stop the background snapshot job.
SNAPSHOT_SCHEDULER_ENABLED=true

# Portfolio change investigations: two amounts agree when they differ by at most
# max(INVESTIGATION_TOLERANCE_INR, INVESTIGATION_TOLERANCE_PCT% of the larger one);
# a latest snapshot older than INVESTIGATION_STALE_HOURS is flagged as stale.
# INVESTIGATION_TOLERANCE_PCT=0.5
# INVESTIGATION_TOLERANCE_INR=1
# INVESTIGATION_STALE_HOURS=36

# Fund figures on the Goals page: returns older than this many days after the
# scheme's NAV date are marked old.
# FUND_STALE_DAYS=5

# Questions with several parts (e.g. account data and a goal) are answered from a plan of tool calls:
# a step that runs longer than PLAN_STEP_TIMEOUT_SECONDS counts as unavailable, and after
# PLAN_DEADLINE_SECONDS no new step starts and the model answers with what it has.
# PLAN_STEP_TIMEOUT_SECONDS=60
# PLAN_DEADLINE_SECONDS=240

# Local app origin (OAuth callback uses this exact address).
APP_ORIGIN=http://localhost:8003

# Sign-in. local (default): the profile picker for one shared computer. google: each
# person signs in with their own Google account (one account per profile, no profile
# list), and their PIN still unlocks their history. Google needs an OAuth web client
# whose redirect URI is APP_ORIGIN + /auth/google/callback.
# AUTH_MODE=local
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Let a Google account claim a profile made with the picker by typing its name and PIN.
# Turn this off once everyone has claimed theirs.
# ALLOW_PROFILE_CLAIMS=true

# Master key that encrypts stored INDmoney tokens. By default it is created at
# ~/.config/ca-mode/master.key; keep it out of .data/ and its backups. Losing it
# means reconnecting INDmoney. Set one of these to use a different key:
# APP_MASTER_KEY_FILE=/path/to/master.key
# APP_MASTER_KEY=

# Daily database backups (chats and snapshots stay sealed with each PIN; the master
# key is never copied). Point BACKUP_DIR at an external drive for off-disk copies.
# BACKUP_DIR=~/ca-mode-backups
# BACKUP_KEEP=14
# BACKUP_ENABLED=true

# Anonymous daily page-view counts kept in the local database (read with python -m scripts.page_views).
# PAGE_VIEWS_ENABLED=true

# Usage limits for a copy shared with other people (README: "Limits for a shared copy").
# All are off by default, which suits one computer.
# Answered chat questions per Free-plan profile per day (resets at midnight in SNAPSHOT_TIMEZONE).
# The pricing page offers 5; paid plans (python -m scripts.plans set ...) are not capped.
# DAILY_QUESTION_LIMIT=5
# Where the /pricing page's "Choose Individual" and "Contact us" buttons send an email.
# PRICING_CONTACT_EMAIL=sales@example.com
# Request rate limits per IP and per profile on chat, sign-up, sign-in and investigations.
# RATE_LIMITS_ENABLED=true
# Behind Cloudflare Tunnel only (no other way to reach the app): read the client IP from CF-Connecting-IP.
# TRUSTED_PROXY=cloudflare
# Cloudflare Turnstile check on sign-up; enabled when both are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: SQLite folder (default .data/) and server log level.
# APP_DATA_DIR=.data
# LOG_LEVEL=INFO

# Port inside the local Docker container.
PORT=8080
